{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "LogFile": {
    "Directory": "logs",
    "MinimumLevel": "Information"
  },

  "Portal": {
    "BaseUrl": "https://api.imcloud.org/site/api/v1/manage",
    "RateLimitPerSecond": 1.5
  },

  "Modules": {
    "Sample": {
      "Enabled": true
    }
  }
}
