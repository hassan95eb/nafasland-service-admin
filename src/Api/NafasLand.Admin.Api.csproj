<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>0cf59ee9-c3ff-4d48-8b5b-10e4c04b52fb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- Only the migration CLI tool (dotnet ef) uses this; not needed at runtime -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Kernel\NafasLand.Admin.Shared.Kernel.csproj" />
    <ProjectReference Include="..\Shared\Infrastructure\NafasLand.Admin.Shared.Infrastructure.csproj" />
    <!--
      This project reference exists only so the module's DLL is copied next to
      Api; Program.cs finds it via assembly scanning (ADR-005), not by referencing
      its types directly.
    -->
    <ProjectReference Include="..\Modules\Sample\NafasLand.Admin.Modules.Sample.csproj" />
    <!--
      Identity is referenced for both reasons: assembly discovery (ADR-005) AND
      because Api's cookie-auth wiring (Program.cs, EffectivePermissionsClaimsTransformation)
      calls into Identity.Contracts directly — the one place a module's public
      surface is meant to be used from outside the module.
    -->
    <ProjectReference Include="..\Modules\Identity\NafasLand.Admin.Modules.Identity.csproj" />
    <!-- Only for assembly discovery (ADR-005); Api never references Auditing's types directly. -->
    <ProjectReference Include="..\Modules\Auditing\NafasLand.Admin.Modules.Auditing.csproj" />
    <!-- Catalog contracts provide PortalOptions; the assembly is also discovered as a module. -->
    <ProjectReference Include="..\Modules\Catalog\NafasLand.Admin.Modules.Catalog.csproj" />
    <!--
      Referenced for both reasons, same as Auditing/Catalog: assembly discovery
      (ADR-005) AND Program.cs calls IApprovalsBootstrapper.ScheduleRecurringJobs()
      directly (see IApprovalsBootstrapper's own comment for why that call cannot
      live inside ApprovalsModule.RegisterServices).
    -->
    <ProjectReference Include="..\Modules\Approvals\NafasLand.Admin.Modules.Approvals.csproj" />
    <!-- Only for assembly discovery (ADR-005); Api never references Returns' types directly. -->
    <ProjectReference Include="..\Modules\Returns\NafasLand.Admin.Modules.Returns.csproj" />
  </ItemGroup>

</Project>
