# This file only shows the setting keys; no real value is here.
# For a local run, make a copy named .env and put the real values in it.

# Password for the sa account in SQL Server (only for the mssql container)
MSSQL_SA_PASSWORD=

# Full connection string that Api uses to connect to mssql
DATABASE__CONNECTIONSTRING=

# Portal settings (ADR-039). Bearer token stays server-side and is never logged.
PORTAL__BASEURL=
PORTAL__BEARERTOKEN=
PORTAL__TESTPRODUCTID=
PORTAL__RATELIMITPERSECOND=1.5
PORTAL__RATELIMITQUEUECAPACITY=20
PORTAL__RATELIMITQUEUETIMEOUTSECONDS=15

# First SuperAdmin account, seeded on startup if none exists yet (ADR-022).
# Never hardcoded; the app does not start without these.
IDENTITY__SUPERADMIN__USERNAME=
IDENTITY__SUPERADMIN__PASSWORD=

# Port exposed to the host, used only in compose.override.yaml (development)
API_HTTP_PORT=8080

# Browser entry point in development. The raw web port is intentionally not exposed.
PROXY_HTTP_PORT=8000

# Server-side Next.js requests use the internal Compose network, not the public proxy.
INTERNAL_API_BASE_URL=http://api:8080
