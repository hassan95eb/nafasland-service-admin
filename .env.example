# این فایل فقط کلید تنظیمات را نشان می‌دهد؛ هیچ مقدار واقعی اینجا نیست.
# برای اجرای محلی یک کپی به نام .env بساز و مقدارهای واقعی را در آن بگذار.

# رمز عبور اکانت sa در SQL Server (فقط برای کانتینر mssql)
MSSQL_SA_PASSWORD=

# رشتهٔ اتصال کامل که Api با آن به mssql وصل می‌شود
DATABASE__CONNECTIONSTRING=

# تنظیمات پرتال (ADR-039) — در این گام هیچ تماسی با پرتال زده نمی‌شود،
# ولی اعتبارسنجی کانفیگ در استارتاپ اجباری است.
PORTAL__BASEURL=
PORTAL__TESTPRODUCTID=

# پورت باز به‌سمت host، فقط در compose.override.yaml (توسعه) استفاده می‌شود
API_HTTP_PORT=8080
