# This file only shows the setting keys; no real value is here.
# For a local run, make a copy named .env and put the real values in it.

# Password for the sa account in SQL Server (only for the mssql container)
MSSQL_SA_PASSWORD=

# Full connection string that Api uses to connect to mssql
DATABASE__CONNECTIONSTRING=

# Portal settings (ADR-039) — no call to the portal is made at this step,
# but config validation at startup is mandatory.
PORTAL__BASEURL=
PORTAL__TESTPRODUCTID=

# Port exposed to the host, used only in compose.override.yaml (development)
API_HTTP_PORT=8080
